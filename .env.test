# .env.test — fake values so config/firebase.ts can initialise under NODE_ENV=test.
# CRA does not load .env.local during tests. Real credentials live in .env.local.
VITE_API_KEY=test-api-key
VITE_AUTH_DOMAIN=animitch-test.firebaseapp.com
VITE_PROJECT_ID=animitch-test
VITE_STORAGE_BUCKET=animitch-test.appspot.com
VITE_MESSAGING_SENDER_ID=000000000000
VITE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_ANILIST_CLIENT_ID=0
VITE_ANILIST_CLIENT_SECRET=test-secret
VITE_ANILIST_CALLBACK_URI=http://localhost:3000/callback
