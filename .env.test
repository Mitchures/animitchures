# .env.test — fake values so config/firebase.ts can initialise under NODE_ENV=test.
# CRA does not load .env.local during tests. Real credentials live in .env.local.
REACT_APP_API_KEY=test-api-key
REACT_APP_AUTH_DOMAIN=animitch-test.firebaseapp.com
REACT_APP_PROJECT_ID=animitch-test
REACT_APP_STORAGE_BUCKET=animitch-test.appspot.com
REACT_APP_MESSAGING_SENDER_ID=000000000000
REACT_APP_APP_ID=1:000000000000:web:0000000000000000000000
REACT_APP_ANILIST_CLIENT_ID=0
REACT_APP_ANILIST_CLIENT_SECRET=test-secret
REACT_APP_ANILIST_CALLBACK_URI=http://localhost:3000/callback
